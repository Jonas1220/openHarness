{
  "name": "openharness",
  "private": true,
  "version": "0.1.0",
  "description": "An open-source agent harness for local, open-weight models — like Codex or Claude Code, but for Ollama.",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "npm run dev -w @openharness/desktop",
    "build": "npm run build -w @openharness/desktop",
    "dist": "npm run dist -w @openharness/desktop",
    "cli": "npm run start -w @openharness/cli --",
    "test": "vitest run",
    "typecheck": "tsc -p packages/core && tsc -p packages/cli && tsc -p apps/desktop"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  }
}
